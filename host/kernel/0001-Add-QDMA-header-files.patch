+u64 rdtsc_gettime(void);
+static inline unsigned int get_next_powof2(unsigned int value)
+{
+	unsigned int num_bits, mask, f_value;
+
+	num_bits = fls(value) - 1;
+	mask = (1 << num_bits) - 1;
+	f_value = ((value + mask) >> num_bits) << num_bits;
+
+	return f_value;
+}
