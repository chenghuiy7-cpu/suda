@@ -0,0 +1,99 @@
+#ifndef QDMA_UL_EXT_H__
+#define QDMA_UL_EXT_H__
+/*
+ * This file is part of the Xilinx DMA IP Core driver for Linux
+ *
+ * Copyright (c) 2017-2020,  Xilinx, Inc.
