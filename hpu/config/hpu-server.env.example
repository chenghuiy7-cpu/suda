# Copy this file outside the repository, fill in the machine-specific values,
# then source it on the remote HPU host. Never commit a real board serial.
export XILINX_VIVADO=/path/to/Vivado
export HPU_CONFIG=v80
export V80_PCIE_DEV=xx
export V80_SERIAL_NUMBER=REPLACE_ME

# Directory containing the installed ami.ko used by the V80 runtime. This is
# a runtime installation path, not a requirement to vendor the AVED repository.
export AMI_PATH=/path/to/installed/ami-driver

export RUST_LOG=info
export HPU_REMOTE_BIND=0.0.0.0:19090
export HPU_REMOTE_SERVER_KEY=/secure/path/psi64_integer_compressed_server_key.bincode
export HPU_REMOTE_SERVER_KEY_SHA256=REPLACE_WITH_SHA256
